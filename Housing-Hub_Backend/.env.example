# Copy this file to .env and fill in local values. Never commit .env.
# .NET maps double underscores to configuration sections: Jwt__Key -> Jwt:Key.
# Values are single-quoted so they are read literally (no $ interpolation).

Jwt__Key='replace-with-a-random-secret-at-least-32-characters'
Smtp__Username='your-email@gmail.com'
Smtp__Password='your-app-password'
SeedSuperAdmin__Name='Super Admin'
SeedSuperAdmin__Email='super-admin@example.com'
SeedSuperAdmin__Password='replace-with-a-strong-password'
SeedSuperAdmin__Phone='0000000000'

# Optional: override the connection string from appsettings.json
# ConnectionStrings__DefaultConnection='Server=(localdb)\MSSQLLocalDB;Database=HousingHubDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;'
